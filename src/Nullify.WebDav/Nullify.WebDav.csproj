<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Authors>Simon Soanes</Authors>
    <Product>Nullify.WebDav</Product>
    <Copyright>Copyright 2026 Simon Soanes</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://git.nullify.net/Simon/Nullify.WebDav</RepositoryUrl>
  </PropertyGroup>

  <!-- Hosting integration only: lets the same binary run as a Windows service or a systemd (Type=notify) unit. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nullify.WebDav.Tests" />
  </ItemGroup>

  <!-- Static assets are embedded so a single-file publish needs no wwwroot folder next to it. -->
  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
