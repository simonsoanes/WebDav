<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Authors>Simon Soanes</Authors>
    <Product>Nullify.WebDav</Product>
    <Copyright>Copyright 2026 Simon Soanes</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://git.nullify.net/Simon/Nullify.WebDav</RepositoryUrl>
  </PropertyGroup>

  <!-- Microsoft packages only: Windows service and systemd (Type=notify) hosting, and OpenID Connect sign-in. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nullify.WebDav.Tests" />
  </ItemGroup>

  <!-- The local development data folder (configuration, key ring, files) is never part of a build or publish. -->
  <ItemGroup>
    <Content Remove="data\**" />
    <None Remove="data\**" />
  </ItemGroup>

  <!-- The browser file manager (Blazor WebAssembly). Its files, the stylesheet and scripts are served by MapStaticAssets
       from the wwwroot folder that publishing puts next to the server. -->
  <ItemGroup>
    <!-- Server publish options (single file, runtime) must not reach the WebAssembly build. -->
    <ProjectReference Include="..\Nullify.WebDav.Client\Nullify.WebDav.Client.csproj"
                      GlobalPropertiesToRemove="PublishSingleFile;IncludeNativeLibrariesForSelfExtract;SelfContained;RuntimeIdentifier;UseAppHost" />
    <ProjectReference Include="..\Nullify.WebDav.Shared\Nullify.WebDav.Shared.csproj" />
  </ItemGroup>

</Project>
