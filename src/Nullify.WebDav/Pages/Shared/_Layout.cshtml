@using Nullify.WebDav.Dav
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole(AppClaims.AdminRole);
    var path = Context.Request.Path.Value ?? "/";
    string Active(string prefix) => (prefix == "/" ? path == "/" : path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    var pm = ViewData.Model as AppPageModel;
    var pathBase = Context.Request.PathBase.Value ?? "";
    var displayName = User.FindFirst(AppClaims.DisplayName)?.Value ?? User.Identity?.Name ?? "";
    var initials = string.Concat(displayName.Split(' ', '.', '_', '-', '@').Where(p => p.Length > 0).Take(2).Select(p => char.ToUpperInvariant(p[0])));
    var hue = (int)((uint)displayName.ToLowerInvariant().Aggregate(17, (h, c) => h * 31 + c) % 360);
    // Sign-in, setup and error pages are a single centred card; everything else sits next to the sidebar.
    var bare = !signedIn || ViewData["Bare"] is true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <title>@(ViewData["Title"] is string t ? t + " · " : "")Nullify.WebDav</title>
    <script src="@(pathBase + "/" + StaticAssets.Url("js/theme.js"))"></script>
    <link rel="icon" href="@(pathBase + "/" + StaticAssets.Url("favicon.svg"))" type="image/svg+xml" />
    <link rel="stylesheet" href="@(pathBase + "/" + StaticAssets.Url("css/app.css"))" />
</head>
<body>
@if (bare)
{
    <div class="login-page">
        <div class="login-card @(ViewData["Wide"] is true ? "wide" : "")">
            <div class="login-brand">
                <div class="brand-mark">@Html.Raw(PageIcons.Get("folder", 20))</div>
                <div>
                    <h1>Nullify.WebDav</h1>
                    <p>@(ViewData["Subtitle"] as string ?? "Your files, anywhere")</p>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(pm?.StatusMessage)) { <div class="alert ok">@pm.StatusMessage</div> }
            @if (!string.IsNullOrEmpty(pm?.ErrorMessage)) { <div class="alert err">@pm.ErrorMessage</div> }
            @RenderBody()
        </div>
        <partial name="_Footer" />
    </div>
}
else
{
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <div class="brand">
                <div class="brand-mark">@Html.Raw(PageIcons.Get("folder", 17))</div>
                <div class="brand-text">Nullify<small>WebDav</small></div>
            </div>
            <a class="btn accent compose-btn" href="~/dav/">@Html.Raw(PageIcons.Get("folder", 16)) <span class="label">Open files</span></a>
            <div class="folder-list">
                <div class="nav-section">
                    <div class="nav-label"><span>You</span></div>
                    <a class="nav-item @Active("/")" asp-page="/Index">@Html.Raw(PageIcons.Get("plug", 17))<span class="label">Connect devices</span></a>
                    <a class="nav-item @Active("/account/profile")" asp-page="/Account/Profile">@Html.Raw(PageIcons.Get("key", 17))<span class="label">Account &amp; app passwords</span></a>
                </div>
                @if (isAdmin)
                {
                    <div class="nav-section">
                        <div class="nav-label"><span>Administration</span></div>
                        <a class="nav-item @Active("/admin/users")" asp-page="/Admin/Users/Index">@Html.Raw(PageIcons.Get("users", 17))<span class="label">Users</span></a>
                        <a class="nav-item @Active("/admin/mounts")" asp-page="/Admin/Mounts/Index">@Html.Raw(PageIcons.Get("folder", 17))<span class="label">Mounts</span></a>
                        <a class="nav-item @Active("/admin/storages")" asp-page="/Admin/Storages/Index">@Html.Raw(PageIcons.Get("hard-drive", 17))<span class="label">Storage</span></a>
                        <a class="nav-item @Active("/admin/shares")" asp-page="/Admin/Shares">@Html.Raw(PageIcons.Get("share", 17))<span class="label">Shares</span></a>
                        <a class="nav-item @Active("/admin/providers")" asp-page="/Admin/Providers/Index">@Html.Raw(PageIcons.Get("shield", 17))<span class="label">Authentication</span></a>
                        <a class="nav-item @Active("/admin/settings")" asp-page="/Admin/Settings">@Html.Raw(PageIcons.Get("settings", 17))<span class="label">Settings</span></a>
                    </div>
                }
            </div>
            <div class="user-chip">
                <a class="avatar sm" style="--hue:@hue" asp-page="/Account/Profile" title="Account">@initials</a>
                <span class="who">
                    <strong title="@User.Identity!.Name">@displayName</strong>
                    <span>@(isAdmin ? "Administrator" : "Signed in")</span>
                </span>
                <form method="post" asp-page="/Account/Logout">
                    <button class="icon-btn small" type="submit" title="Sign out">@Html.Raw(PageIcons.Get("logout", 16))</button>
                </form>
            </div>
        </aside>
        <div class="splitter" role="separator" aria-orientation="vertical"></div>
        <div class="main-area">
            <div class="page-pane">
                <div class="pane-toolbar show-menu" style="display:none;">
                    <a class="icon-btn" href="#sidebar" title="Menu">@Html.Raw(PageIcons.Get("menu", 18))</a>
                </div>
                <main class="settings-page">
                    @if (!string.IsNullOrEmpty(pm?.StatusMessage)) { <div class="alert ok">@pm.StatusMessage</div> }
                    @if (!string.IsNullOrEmpty(pm?.ErrorMessage)) { <div class="alert err">@pm.ErrorMessage</div> }
                    @RenderBody()
                </main>
                <partial name="_Footer" />
            </div>
        </div>
    </div>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
