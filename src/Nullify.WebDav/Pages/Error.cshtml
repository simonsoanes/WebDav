@page "/error"
@model ErrorModel
@{
    ViewData["Title"] = "Error";
    ViewData["Bare"] = true;
}
<h2 style="font-size:1.05rem;margin-bottom:.35rem;">Something went wrong</h2>
<p class="lead">An unexpected error occurred while processing your request.</p>
@if (!string.IsNullOrEmpty(Model.RequestId))
{
    <p class="fine-print">Request ID: <code>@Model.RequestId</code></p>
}
<a class="btn block" href="~/dav/">Back to your files</a>
