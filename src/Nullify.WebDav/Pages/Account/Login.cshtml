@page
@model Nullify.WebDav.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<p class="lead">Sign in to open your files, share folders and get connection details for your devices.</p>
        <partial name="_ValidationSummary" />
        <form method="post" class="stack">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="field">
                <label asp-for="Username">Username</label>
                <input asp-for="Username" autocomplete="username" autofocus />
                @if (Model.HasProviders)
                {
                    <span class="hint">Your server, Windows or directory account, as set up by your administrator.</span>
                }
            </div>
            <div class="field">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="current-password" />
            </div>
            <button class="primary block" type="submit">Sign in</button>
        </form>
